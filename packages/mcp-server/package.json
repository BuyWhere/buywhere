{
  "name": "@buywhere/mcp-server",
  "version": "1.0.0",
  "description": "Agent-native product catalog MCP server. Search & compare more than 360M products from roughly 950K merchants in 80+ countries, with deepest coverage in the United States and Singapore and growing coverage across UK, EU, SEA, and AU. Location-aware search via `deliver_to=<ISO country>` and `availability` labels (local | ships_to_you | unavailable | unknown); agent-optimized responses via `compact=true`. Canonical stats: GET /v1/catalog/stats.",
  "type": "module",
  "bin": {
    "buywhere-mcp-server": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "check-drift": "node scripts/check-schema-drift.mjs",
    "prepublishOnly": "node scripts/prepublish-guard.mjs"
  },
  "mcpName": "ai.buywhere/buywhere-mcp",
  "keywords": [
    "buywhere",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "product-search",
    "product-search-api",
    "product-search-mcp",
    "agent-product-search",
    "mcp-commerce-search",
    "ecommerce-api",
    "ecommerce",
    "shopping-api",
    "shopping-agent",
    "shopping",
    "price-comparison",
    "compare-prices",
    "price-tracker",
    "deal-finder",
    "deal-discovery",
    "catalog-search",
    "product-catalog",
    "cross-border",
    "cross-border-shopping",
    "cross-border-commerce",
    "multi-currency",
    "real-time-pricing",
    "southeast-asia",
    "singapore",
    "sea-markets",
    "us-markets",
    "ai-agent",
    "ai-agents",
    "e-commerce",
    "ai-commerce",
    "agent-commerce",
    "agent-shopping",
    "agent-to-agent",
    "a2a",
    "google-a2a",
    "llm",
    "ai-tools",
    "claude-desktop",
    "cursor",
    "cline",
    "windsurf",
    "open-code",
    "codex",
    "continue-dev",
    "smithery",
    "mcp-tools",
    "typescript"
  ],
  "author": "BuyWhere",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuyWhere/buywhere.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://buywhere.ai",
  "bugs": {
    "url": "https://github.com/BuyWhere/buywhere/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
