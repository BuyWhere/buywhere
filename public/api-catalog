{
  "catalogVersion": "1.0",
  "lastUpdated": "2026-05-29T00:00:00Z",
  "baseUrl": "https://api.buywhere.ai",
  "authentication": {
    "type": "bearer",
    "description": "Authorization: Bearer bw_live_YOUR_API_KEY"
  },
  "apiVersion": "v1",
  "endpoints": [
    {
      "name": "search_products",
      "path": "/v1/products",
      "method": "GET",
      "description": "Full-text search with merchant, price, category, and country filters",
      "parameters": {
        "query": {"type": "string", "required": true, "description": "Search query"},
        "merchant": {"type": "string", "required": false, "description": "Filter by merchant"},
        "category": {"type": "string", "required": false, "description": "Filter by category"},
        "min_price": {"type": "number", "required": false, "description": "Minimum price"},
        "max_price": {"type": "number", "required": false, "description": "Maximum price"},
        "country": {"type": "string", "required": false, "description": "Country code (default: SG)"}
      }
    },
    {
      "name": "get_product",
      "path": "/v1/products/{product_id}",
      "method": "GET",
      "description": "Get full product details by BuyWhere product ID"
    },
    {
      "name": "get_price",
      "path": "/v1/offers",
      "method": "GET",
      "description": "Get current prices for a product across all available merchants",
      "parameters": {
        "product_id": {"type": "string", "required": true, "description": "BuyWhere product ID"}
      }
    },
    {
      "name": "compare_prices",
      "path": "/v1/products/compare",
      "method": "GET",
      "description": "Compare 2-5 products side-by-side with price range and recommendations",
      "parameters": {
        "product_ids": {"type": "string", "required": true, "description": "Comma-separated product IDs (2-5)"}
      }
    },
    {
      "name": "get_affiliate_link",
      "path": "/v1/affiliate",
      "method": "GET",
      "description": "Get click-tracked BuyWhere affiliate link for a product",
      "parameters": {
        "product_id": {"type": "string", "required": true, "description": "BuyWhere product ID"}
      }
    },
    {
      "name": "get_catalog",
      "path": "/v1/categories",
      "method": "GET",
      "description": "List available product categories in the BuyWhere catalog"
    },
    {
      "name": "list_merchants",
      "path": "/v1/merchants",
      "method": "GET",
      "description": "List all merchants with product counts for merchant landing pages",
      "parameters": {
        "country": {"type": "string", "required": false, "description": "Country code filter (default: SG)"}
      }
    },
    {
      "name": "get_merchant",
      "path": "/v1/merchants/{merchant_id}",
      "method": "GET",
      "description": "Get merchant details including name, URL, logo, social links, and top products for Organization JSON-LD page"
    }
  ],
  "mcp": {
    "endpoint": "https://api.buywhere.ai/mcp",
    "transport": "streamable-http",
    "tools": ["search_products", "get_product", "get_price", "compare_prices", "get_affiliate_link", "get_catalog", "list_merchants", "get_merchant"]
  },
  "coverage": {
    "products": "2M+",
    "merchants": 40,
    "country": "Singapore"
  }
}