{
  "name": "BuyWhere",
  "type": "service",
  "description": "Agent-native product catalog API for AI shopping agents: 381M+ products from 900,000+ merchants worldwide, with location-aware deliver_to ranking and per-result availability labels.",
  "version": "1.0.0",
  "capabilities": ["product-search", "price-comparison", "location-aware-shopping", "cross-storefront-comparison", "affiliate-attribution"],
  "protocols": ["MCP", "A2A", "HTTP/REST"],
  "endpoints": {
    "mcp": "https://api.buywhere.ai/mcp",
    "a2a": "https://api.buywhere.ai/a2a",
    "rest": "https://api.buywhere.ai/v1"
  },
  "auth": {
    "type": "apiKey",
    "header": "Authorization: Bearer",
    "docs": "https://buywhere.ai/api-keys"
  },
  "catalog": {
    "products": "381M+",
    "storefronts": "900K+",
    "locationAwareParameter": "deliver_to",
    "availabilityLabels": ["local", "ships_to_you", "unavailable", "unknown"]
  },
  "contact": "agents@buywhere.ai",
  "status": "https://status.buywhere.ai",
  "trust_score": 0.95
}
