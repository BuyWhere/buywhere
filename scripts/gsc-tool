#!/usr/bin/env python3
"""GSC ops tool for Lyra — ongoing index-health ownership of buywhere.ai.
Usage:
  gsc-tool submit-sitemaps          # resubmit all sitemaps (do after any page fix)
  gsc-tool sitemaps                 # list sitemaps + submitted/indexed/error counts
  gsc-tool inspect <url>            # index status + coverageState + why-not-indexed
  gsc-tool coverage <url> [url...]  # bucketed coverage summary for many URLs
  gsc-tool analytics [days]         # top pages by clicks/impressions (default 28d)
  gsc-tool request-index <url>...   # ask Google to (re)crawl URLs  [Indexing API; ~200/day quota]
  gsc-tool request-deindex <url>... # tell Google a URL is gone (URL_DELETED) — for 410'd pages
Auth: service account at $GOOGLE_APPLICATION_CREDENTIALS (gsc-reader, siteOwner of sc-domain:buywhere.ai).
NOTE: GSC API cannot click 'Validate Fix' (UI-only). request-index is best-effort (Google may not act
on non-job pages). Reliable levers remain: fix the page + submit-sitemaps; request-index is a nudge.
"""
import os, sys, json, urllib.request, urllib.error, xml.etree.ElementTree as ET
from datetime import date, timedelta
from google.oauth2 import service_account
from googleapiclient.discovery import build

SITE = os.environ.get("GSC_SITE_URL", "sc-domain:buywhere.ai")
KEY = os.environ.get("GOOGLE_APPLICATION_CREDENTIALS", "/home/paperclip/.secrets/gsc-reader.json")

def _discover_sitemaps():
    """Fetch the root sitemap index and return all child loc URLs."""
    root_url = "https://buywhere.ai/sitemap.xml"
    try:
        req = urllib.request.Request(root_url, headers={"User-Agent": "gsc-tool/1.0"})
        with urllib.request.urlopen(req, timeout=15) as resp:
            body = resp.read()
        tree = ET.fromstring(body)
        ns = {"sm": "http://www.sitemaps.org/schemas/sitemap/0.9"}
        locs = [loc.text for loc in tree.findall(".//sm:sitemap/sm:loc", ns) if loc.text]
        if not locs:
            # no namespace fallback
            locs = [loc.text for loc in tree.findall(".//sitemap/loc") if loc.text]
        live = []
        for loc in locs:
            try:
                req2 = urllib.request.Request(loc, method="HEAD", headers={"User-Agent": "gsc-tool/1.0"})
                with urllib.request.urlopen(req2, timeout=15) as r:
                    code = r.status
            except urllib.error.HTTPError as e:
                code = e.code
            except Exception:
                code = None
            if code and 200 <= int(code) < 300:
                live.append(loc)
            else:
                print(f"skip non-2xx child {loc} status={code}", file=sys.stderr)
        return [root_url] + (live if live else [])
    except Exception as e:
        print(f"Warning: failed to discover sitemaps from root ({e}); using fallback list", file=sys.stderr)
        return [root_url,
                "https://buywhere.ai/sitemap-products.xml",
                "https://buywhere.ai/sitemap-pages.xml",
                "https://buywhere.ai/sitemap-categories.xml",
                "https://buywhere.ai/sitemap-merchants.xml"]

def sc(scope="https://www.googleapis.com/auth/webmasters"):
    c=service_account.Credentials.from_service_account_file(KEY,scopes=[scope]); return build("searchconsole","v1",credentials=c)
def idxapi():
    c=service_account.Credentials.from_service_account_file(KEY,scopes=["https://www.googleapis.com/auth/indexing"]); return build("indexing","v3",credentials=c)

def main():
    cmd=sys.argv[1] if len(sys.argv)>1 else "sitemaps"
    if cmd=="submit-sitemaps":
        s=sc()
        for sm in _discover_sitemaps():
            try: s.sitemaps().submit(siteUrl=SITE,feedpath=sm).execute(); print(f"submitted {sm}")
            except Exception as e: print(f"skip {sm}: {e}")
    elif cmd=="sitemaps":
        for sm in sc().sitemaps().list(siteUrl=SITE).execute().get("sitemap",[]):
            c=(sm.get("contents") or [{}])[0]
            print(f"{sm['path']} | submitted={c.get('submitted','?')} indexed={c.get('indexed','?')} errors={sm.get('errors')} warnings={sm.get('warnings')} last={sm.get('lastSubmitted','?')[:10]}")
    elif cmd=="inspect":
        r=sc().urlInspection().index().inspect(body={"inspectionUrl":sys.argv[2],"siteUrl":SITE}).execute()
        v=r["inspectionResult"]["indexStatusResult"]
        print(json.dumps({k:v.get(k) for k in ("verdict","coverageState","robotsTxtState","pageFetchState","lastCrawlTime","googleCanonical","userCanonical")},indent=2))
    elif cmd=="coverage":
        from collections import Counter; b=Counter(); s=sc()
        for u in sys.argv[2:]:
            try: b[s.urlInspection().index().inspect(body={"inspectionUrl":u,"siteUrl":SITE}).execute()["inspectionResult"]["indexStatusResult"].get("coverageState","?")]+=1
            except Exception as e: b[f"ERROR:{e}"[:40]]+=1
        for k,n in b.most_common(): print(f"{n:4d}  {k}")
    elif cmd=="analytics":
        days=int(sys.argv[2]) if len(sys.argv)>2 else 28
        end=date.today(); start=end-timedelta(days=days)
        r=sc().searchanalytics().query(siteUrl=SITE,body={"startDate":start.isoformat(),"endDate":end.isoformat(),"dimensions":["page"],"rowLimit":15}).execute()
        for row in r.get("rows",[]): print(f"clicks={row['clicks']:>4} impr={row['impressions']:>5}  {row['keys'][0]}")
        print(f"(indexed pages with impressions: {len(r.get('rows',[]))})")
    elif cmd in ("request-index","request-deindex"):
        typ="URL_UPDATED" if cmd=="request-index" else "URL_DELETED"; api=idxapi(); ok=0
        for u in sys.argv[2:]:
            try: api.urlNotifications().publish(body={"url":u,"type":typ}).execute(); ok+=1; print(f"{typ} {u}")
            except Exception as e: print(f"FAIL {u}: {e}")
        print(f"({ok}/{len(sys.argv)-2} accepted; Indexing API quota ~200/day)")
    else: print(__doc__)
if __name__=="__main__": main()
