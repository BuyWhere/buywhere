@@ -13,6 +13,7 @@ SCRAPER_CMD=(python3 -m scrapers.carousell_sg --scrape-only --continuous --refres
 SCRAPER_PROC_PATTERN="python3 -m scrapers\.carousell_sg .*--continuous"
