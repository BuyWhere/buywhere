{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npx next build --no-lint",
    "watchPatterns": ["src/**", "public/**", "content/**", "next.config.*"]
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "node .next-deploy/standalone/server.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "healthcheckPath": "/",
    "healthcheckTimeout": 30
  }
}
